# syntax=docker/dockerfile:1.6
ARG NODE_VERSION=20

FROM node:${NODE_VERSION}-alpine AS deps
WORKDIR /workspace

RUN apk add --no-cache python3 make g++

# Install dependencies (cached layer)
COPY package.json package-lock.json ./
# Skip config directory and service account files - using environment variables

RUN npm install --legacy-peer-deps

FROM deps AS build
# Copy source code
COPY nx.json tsconfig.json tsconfig.base.json jest.preset.js eslint.config.mjs ./
COPY apps ./apps

# Build
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}
RUN npx nx sync && npx nx build backend

FROM node:${NODE_VERSION}-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN apk add --no-cache dumb-init

# Copy only production dependencies and built code
COPY --from=deps /workspace/node_modules ./node_modules
COPY --from=deps /workspace/package.json ./package.json
COPY --from=build /workspace/apps/backend/dist ./dist

# Firebase credentials are now provided via environment variables in Cloud Run

USER node
EXPOSE 3000
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/main.js"]
