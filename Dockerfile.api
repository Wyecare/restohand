# syntax=docker/dockerfile:1.6
ARG NODE_VERSION=20

FROM node:${NODE_VERSION}-alpine AS deps
WORKDIR /workspace

RUN apk add --no-cache python3 make g++

COPY package.json package-lock.json ./
COPY nx.json ./
COPY tsconfig.json ./
COPY tsconfig.base.json ./
COPY jest.preset.js ./
COPY eslint.config.mjs ./
COPY libs ./libs
COPY apps ./apps
# Skip config directory - Google Cloud Storage uses Application Default Credentials

RUN npm install

FROM deps AS build
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}
RUN npx nx build backend --configuration=production --skip-nx-cache

FROM node:${NODE_VERSION}-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN apk add --no-cache dumb-init

COPY --from=deps /workspace/package.json ./package.json
COPY --from=deps /workspace/package-lock.json ./package-lock.json

RUN npm ci --omit=dev

COPY --from=build /workspace/apps/backend/dist ./dist

# Google Cloud Storage uses Application Default Credentials (ADC) from Cloud Run service account

USER node
EXPOSE 3000
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/main.js"]
