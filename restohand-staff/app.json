{
  "expo": {
    "name": "restohand-staff",
    "slug": "restohand-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "restohand-staff",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anandhusathee.restohandstaff"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anandhusathee.restohandstaff"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45832152-a181-40c6-87bb-8a32437d3d03"
      }
    },
    "owner": "wyecare-solutions",
    "updates": {
      "url": "https://u.expo.dev/5941d4e9-100a-421a-ad9e-18bb06662ec1"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
