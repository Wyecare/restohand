###
# Razorpay Subscriptions Management
# Base URL: https://api.razorpay.com/v1
# Auth: Basic Auth with Key ID and Secret
###

@baseUrl = https://api.razorpay.com/v1
@keyId = YOUR_RAZORPAY_KEY_ID
@keySecret = YOUR_RAZORPAY_KEY_SECRET
@planId = plan_PLAN_ID_HERE
@subscriptionId = sub_SUBSCRIPTION_ID_HERE

### Create Subscription with Free Trial (First Month Free)
POST {{baseUrl}}/subscriptions
Authorization: Basic {{keyId}}:{{keySecret}}
Content-Type: application/json

{
  "plan_id": "{{planId}}",
  "total_count": 12,
  "quantity": 1,
  "customer_notify": false,
  "start_at": 1738665600,
  "notes": {
    "restaurant_id": "RESTAURANT_ID_HERE",
    "free_trial": "first_month",
    "trial_end_date": "2026-02-23"
  }
}

### Create Subscription - Immediate Start (No Trial)
POST {{baseUrl}}/subscriptions
Authorization: Basic {{keyId}}:{{keySecret}}
Content-Type: application/json

{
  "plan_id": "{{planId}}",
  "total_count": 12,
  "quantity": 1,
  "customer_notify": false,
  "notes": {
    "restaurant_id": "RESTAURANT_ID_HERE",
    "trial": "none"
  }
}

### Fetch All Subscriptions
GET {{baseUrl}}/subscriptions
Authorization: Basic {{keyId}}:{{keySecret}}

### Fetch Specific Subscription
GET {{baseUrl}}/subscriptions/{{subscriptionId}}
Authorization: Basic {{keyId}}:{{keySecret}}

### Update Subscription (Upgrade/Downgrade Plan)
PATCH {{baseUrl}}/subscriptions/{{subscriptionId}}
Authorization: Basic {{keyId}}:{{keySecret}}
Content-Type: application/json

{
  "plan_id": "NEW_PLAN_ID_HERE",
  "schedule_change_at": "now",
  "customer_notify": false,
  "notes": {
    "upgrade_reason": "customer_requested",
    "previous_plan": "{{planId}}"
  }
}

### Pause Subscription
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/pause
Authorization: Basic {{keyId}}:{{keySecret}}
Content-Type: application/json

{
  "pause_at": "now"
}

### Resume Subscription
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/resume
Authorization: Basic {{keyId}}:{{keySecret}}
Content-Type: application/json

{
  "resume_at": "now"
}

### Cancel Subscription (Immediate)
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/cancel
Authorization: Basic {{keyId}}:{{keySecret}}
Content-Type: application/json

{
  "cancel_at_cycle_end": false
}

### Cancel Subscription (At Cycle End)
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/cancel
Authorization: Basic {{keyId}}:{{keySecret}}
Content-Type: application/json

{
  "cancel_at_cycle_end": true
}

### Fetch Subscription Invoices
GET {{baseUrl}}/invoices?subscription_id={{subscriptionId}}
Authorization: Basic {{keyId}}:{{keySecret}}