  "interval": 1,
  "item": {
    "name": "RestoHand Starter - Yearly",
    "amount": 769900,
    "currency": "INR",
    "description": "Starter plan billed annually. Save 2 months! Perfect for new cloud kitchens and small cafes."
  },
  "notes": {
    "tier": "starter",
    "billing_cycle": "yearly",
    "locations": "1",
    "tables": "10",
    "features": "basic_analytics,email_support,qr_ordering",
    "discount": "2_months_free"
  }
}

