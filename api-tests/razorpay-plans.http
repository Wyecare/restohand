###
# Razorpay Plans Management
# Base URL: https://api.razorpay.com/v1
# Auth: Basic Auth with Key ID and Secret
###

@baseUrl = https://api.razorpay.com/v1
@keyId = rzp_live_RbHutYgpJaFNZ8
@keySecret = K0yG0fEBzdeaAU1MdtrdRp4J

### Create Starter Monthly Plan
POST {{baseUrl}}/plans
Authorization: Basic {{keyId}}:{{keySecret}}
Content-Type: application/json

{
  "period": "monthly",
  "interval": 1,
  "item": {
    "name": "RestoHand Starter - Monthly",
    "amount": 69900,
    "currency": "INR",
    "description": "Perfect for new cloud kitchens and small cafes. Single location, up to 10 tables, basic analytics."
  },
  "notes": {
    "tier": "starter",
    "billing_cycle": "monthly",
    "locations": "1",
    "tables": "10",
    "features": "basic_analytics,email_support,qr_ordering"
  }
}

### Create Professional Monthly Plan
POST {{baseUrl}}/plans
Authorization: Basic {{keyId}}:{{keySecret}}
